{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracemind.io/schemas/v0.1/kinds/patch.schema.json",
  "title": "Canonical AST - Patch",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "Patch"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal_id", "target_ref", "changes", "applied_at"],
          "properties": {
            "proposal_id": {
              "type": "string",
              "minLength": 1
            },
            "target_ref": {
              "type": "string",
              "minLength": 1
            },
            "changes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "op"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "op": {
                    "type": "string",
                    "enum": ["add", "remove", "replace", "set"]
                  },
                  "value": {},
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "applied_at": {
              "type": "string",
              "format": "date-time"
            },
            "hash": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
